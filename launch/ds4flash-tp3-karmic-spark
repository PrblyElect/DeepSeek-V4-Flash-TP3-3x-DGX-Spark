#!/usr/bin/env bash
# Node-local lifecycle helper for the ds4flash TP=3 ring — SPEED profile
# (karmic-kraken image + DSpark speculative decoding). Validated
# 2026-10-03/04 alongside config/cluster.env; the bring-up ladder behind
# every design choice is in docs/FIXLOG.md.
#
# vs the capacity-profile helper (launch/ds4flash-tp3-spark): mp executor
# (--nnodes 3, no Ray, no pip installs at container start), b12x 1.5.0 +
# NCCL baked in the image (no LD_PRELOAD/entrypoint fights, no tilelang
# patch), DSpark speculative decode, async scheduling, and the three
# patches-karmic/ TP=3 padding mounts — mandatory: without them the boot
# dies at head divisibility (64 % 3).
set -euo pipefail

action="${1:-status}"

env_file="${DS4FLASH_ENV:-$HOME/ds4flash-tp3/.env.tp3-ds-karmic}"
cache_root="${DS4FLASH_CACHE:-$HOME/.cache/ds4flash-tp3}"
mgmt_if="${MGMT_IF:-enP7s7}"
# One GPU owner per box: refuse to start beside any resident model lane.
# Tune the pattern to whatever else runs on your boxes.
resident_pattern="${RESIDENT_PATTERN:-vllm|sglang|exl|rank[0-9]}"

[[ -f "$env_file" ]] || { echo "missing $env_file (run launch/ds4flash-tp3-up stage-env)" >&2; exit 1; }
# shellcheck disable=SC1090
source "$env_file"

case "$(hostname -s)" in
  "$HEAD_HOST") rank=0; host_ip="$HEAD_IP"; hca="$HEAD_HCA" ;;
  "$W1_HOST")   rank=1; host_ip="$W1_IP";   hca="$W1_HCA" ;;
  "$W2_HOST")   rank=2; host_ip="$W2_IP";   hca="$W2_HCA" ;;
  *) echo "unsupported host: $(hostname -s)" >&2; exit 2 ;;
esac
case "$rank" in
  0) container="ds4flash-tp3-head" ;;
  1) container="ds4flash-tp3-worker1" ;;
  2) container="ds4flash-tp3-worker2" ;;
esac
image="$IMAGE${IMAGE_DIGEST:+@$IMAGE_DIGEST}"

preflight() {
  test -f "$MODEL_DIR/_DOWNLOAD_COMPLETE.json" || {
    echo "checkpoint marker missing: $MODEL_DIR/_DOWNLOAD_COMPLETE.json" >&2; return 1; }
  local shards
  shards=$(find "$MODEL_DIR" -maxdepth 1 -type f \
    -name 'model-[0-9][0-9][0-9][0-9][0-9]-of-00048.safetensors' | wc -l)
  [[ "$shards" -eq "$EXPECTED_SHARDS" ]] || {
    echo "shard count $shards != $EXPECTED_SHARDS" >&2; return 1; }
  docker image inspect "$image" >/dev/null 2>&1 || {
    echo "image missing: $image" >&2; return 1; }
  test -e /dev/infiniband || { echo "/dev/infiniband absent" >&2; return 1; }
  local busy
  busy=$(docker ps --format '{{.Names}}' | grep -Ei "$resident_pattern" | grep -v "$container" || true)
  [[ -z "$busy" ]] || { echo "refusing: resident model container(s): $busy" >&2; return 1; }
}

serve_args=(
  --served-model-name "$SERVED_NAME" deepseek
  --trust-remote-code
  --tensor-parallel-size 3
  --pipeline-parallel-size 1
  --distributed-executor-backend mp
  --nnodes 3
  --node-rank "$rank"
  --master-addr "$HEAD_IP"
  --master-port "$MASTER_PORT"
  --kv-cache-dtype "$KV_CACHE_DTYPE"
  --block-size 256
  --max-model-len "$MAX_MODEL_LEN"
  --max-num-seqs "$MAX_NUM_SEQS"
  --max-num-batched-tokens "$MAX_NUM_BATCHED_TOKENS"
  --gpu-memory-utilization "$GPU_MEM_UTIL"
  --load-format "${LOAD_FORMAT:-safetensors}"
  --attention-backend B12X
  --moe-backend b12x
  --tokenizer-mode deepseek_v4
  --reasoning-parser deepseek_v4
  --tool-call-parser deepseek_v4
  --enable-auto-tool-choice
  --enable-chunked-prefill
  --enable-prefix-caching
  --prefix-cache-retention-interval 4096
  --no-scheduler-reserve-full-isl
  --async-scheduling
  --max-cudagraph-capture-size 144
  --compilation-config '{"cudagraph_mode":"FULL_AND_PIECEWISE","custom_ops":["all"]}'
  --enable-flashinfer-autotune
)
if [[ -n "${SPEC_CONFIG:-}" ]]; then
  serve_args+=(--speculative-config "$SPEC_CONFIG")
fi
if [[ -n "${ATTENTION_CONFIG:-}" ]]; then
  serve_args+=(--attention-config "$ATTENTION_CONFIG")
fi
if [[ "$rank" == 0 ]]; then
  serve_args+=(--host 0.0.0.0 --port "$API_PORT")
fi

start() {
  preflight
  mkdir -p "$cache_root"/{vllm,flashinfer,triton,torch,nccl,karmic-cache}
  docker rm -f "$container" 2>/dev/null || true
  # TP3 padding patches (config-level V4->V4.1 delegation + v4 attention
  # allow_tp_padding) — mandatory: without them the boot dies at head
  # divisibility (64 % 3).
  local pk="$HOME/ds4flash-tp3/patches-karmic"
  local patch_mounts=()
  if [[ -f "$pk/config.py" && -f "$pk/v4-attention.py" && -f "$pk/v4-model.py" ]]; then
    patch_mounts=(
      -v "$pk/config.py":/usr/local/lib/python3.12/dist-packages/vllm/model_executor/models/config.py:ro
      -v "$pk/v4-attention.py":/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v4/attention.py:ro
      -v "$pk/v4-model.py":/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v4/nvidia/model.py:ro
    )
  else
    echo "TP3 padding patches missing in $pk — boot will fail at head divisibility" >&2; return 1
  fi
  # Workers start first so the head never waits on a cold container (house pattern).
  docker run -d --name "$container" \
    --privileged --network host --ipc host \
    --shm-size 64g --ulimit memlock=-1 --ulimit stack=67108864 \
    --gpus all \
    --restart no \
    --entrypoint bash \
    -v "$MODEL_DIR":"$MODEL_DIR":ro \
    "${patch_mounts[@]}" \
    -v "$cache_root/vllm":"/root/.cache/vllm" \
    -v "$cache_root/flashinfer":"/root/.cache/flashinfer" \
    -v "$cache_root/triton":"/root/.cache/triton" \
    -v "$cache_root/torch":"/root/.cache/torch" \
    -v "$cache_root/karmic-cache":"/cache" \
    -e NCCL_IB_DISABLE="$NCCL_IB_DISABLE" \
    -e NCCL_NET="$NCCL_NET" \
    -e NCCL_NET_PLUGIN="$NCCL_NET_PLUGIN" \
    -e NCCL_IB_HCA="$hca" \
    -e NCCL_IB_GID_INDEX="$NCCL_IB_GID_INDEX" \
    -e NCCL_IB_ADDR_FAMILY="$NCCL_IB_ADDR_FAMILY" \
    -e NCCL_IB_ROCE_VERSION_NUM="$NCCL_IB_ROCE_VERSION_NUM" \
    -e NCCL_IB_SUBNET_AWARE_ROUTING="$NCCL_IB_SUBNET_AWARE_ROUTING" \
    -e NCCL_P2P_DISABLE="$NCCL_P2P_DISABLE" \
    -e NCCL_NVLS_ENABLE="$NCCL_NVLS_ENABLE" \
    -e NCCL_PROTO="$NCCL_PROTO" \
    -e NCCL_BUFFSIZE="$NCCL_BUFFSIZE" \
    -e NCCL_LL128_BUFFSIZE="$NCCL_LL128_BUFFSIZE" \
    -e NCCL_MAX_NCHANNELS="$NCCL_MAX_NCHANNELS" \
    -e NCCL_MIN_NCHANNELS="$NCCL_MIN_NCHANNELS" \
    -e NCCL_DEBUG="${NCCL_DEBUG:-WARN}" \
    -e NCCL_SOCKET_IFNAME="$mgmt_if" \
    -e GLOO_SOCKET_IFNAME="$mgmt_if" \
    -e TP_SOCKET_IFNAME="$mgmt_if" \
    -e VLLM_HOST_IP="$host_ip" \
    -e CUTE_DSL_ARCH="$CUTE_DSL_ARCH" \
    -e VLLM_USE_AOT_COMPILE="$VLLM_USE_AOT_COMPILE" \
    -e VLLM_USE_MEGA_AOT_ARTIFACT="$VLLM_USE_MEGA_AOT_ARTIFACT" \
    -e VLLM_MEMORY_PROFILE_INCLUDE_ATTN="$VLLM_MEMORY_PROFILE_INCLUDE_ATTN" \
    -e VLLM_USE_FLASHINFER_SAMPLER="$VLLM_USE_FLASHINFER_SAMPLER" \
    -e VLLM_USE_V2_MODEL_RUNNER="$VLLM_USE_V2_MODEL_RUNNER" \
    -e VLLM_USE_B12X_WO_PROJECTION="$VLLM_USE_B12X_WO_PROJECTION" \
    -e VLLM_USE_B12X_MHC="$VLLM_USE_B12X_MHC" \
    -e VLLM_USE_B12X_FP8_GEMM="$VLLM_USE_B12X_FP8_GEMM" \
    -e VLLM_USE_B12X_MOE="$VLLM_USE_B12X_MOE" \
    -e VLLM_USE_B12X_SPARSE_INDEXER="$VLLM_USE_B12X_SPARSE_INDEXER" \
    -e B12X_MLA_SM120_UNIFIED="$B12X_MLA_SM120_UNIFIED" \
    -e B12X_MOE_FORCE_A8="$B12X_MOE_FORCE_A8" \
    -e B12X_W4A8_TINY_DECODE="$B12X_W4A8_TINY_DECODE" \
    -e VLLM_MOE_SKIP_PADDING="$VLLM_MOE_SKIP_PADDING" \
    -e VLLM_PLUGINS="$VLLM_PLUGINS" \
    -e VLLM_ALLOW_LONG_MAX_MODEL_LEN="$VLLM_ALLOW_LONG_MAX_MODEL_LEN" \
    -e VLLM_ENGINE_READY_TIMEOUT_S="$VLLM_ENGINE_READY_TIMEOUT_S" \
    -e VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS="$VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS" \
    -e VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS="$VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS" \
    -e SAFETENSORS_FAST_GPU="$SAFETENSORS_FAST_GPU" \
    -e OMP_NUM_THREADS="$OMP_NUM_THREADS" \
    -e TORCH_NCCL_ASYNC_ERROR_HANDLING="$TORCH_NCCL_ASYNC_ERROR_HANDLING" \
    -e CUDA_DEVICE_MAX_CONNECTIONS="$CUDA_DEVICE_MAX_CONNECTIONS" \
    -e PYTORCH_CUDA_ALLOC_CONF="$PYTORCH_CUDA_ALLOC_CONF" \
    -e TRITON_CACHE_DIR=/cache/triton \
    -e TORCHINDUCTOR_CACHE_DIR=/cache/inductor \
    -e CUTE_DSL_CACHE_DIR=/cache/cute \
    -e TILELANG_CACHE_DIR=/cache/tilelang \
    -e B12X_COMPILE_CACHE_DIR=/cache/b12x-compile \
    -e B12X_CUTE_CACHE_DIR=/cache/b12x-cute \
    -e VLLM_CACHE_ROOT=/cache/vllm-root \
    "$image" \
    -c "exec vllm serve $(printf '%q' "$MODEL_DIR")$(printf ' %q' "${serve_args[@]}")"
  echo "started $container (rank $rank on $(hostname -s)); logs: docker logs -f $container"
}

case "$action" in
  start)   start ;;
  stop)    docker rm -f "$container" 2>/dev/null || true; echo "stopped $container" ;;
  status)
    if docker inspect --format '{{.State.Status}}' "$container" 2>/dev/null; then
      docker logs --tail 5 "$container" 2>&1 | sed 's/^/  /'
    else
      echo "$container not present on $(hostname -s)"
    fi ;;
  logs)    docker logs -f --tail 100 "$container" ;;
  preflight) preflight && echo "preflight ok on $(hostname -s) (rank $rank)" ;;
  *) echo "usage: ds4flash-tp3-karmic-spark {start|stop|status|logs|preflight}" >&2; exit 2 ;;
esac
