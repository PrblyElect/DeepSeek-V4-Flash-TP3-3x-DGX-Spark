#!/usr/bin/env bash
# Node-local lifecycle helper for the ds4flash TP=3 ring (DeepSeek-V4-Flash,
# full weights) on a 3x DGX Spark CX-7 triangle.
#
# Validated profile (2026-10-03/04): 9/9 clean cold boots through the
# eager -> PIECEWISE -> FULL cudagraph ladder. Runs on every box; rank is
# derived by matching `hostname -s` against HEAD_HOST/W1_HOST/W2_HOST from
# the staged env file.
#
# The chthonic virtual-TP path pads DS4 shapes automatically at TP=3 —
# expert parallelism is FORBIDDEN on that path, so --enable-expert-parallel
# must never appear here.
set -euo pipefail

action="${1:-status}"

env_file="${DS4FLASH_ENV:-$HOME/ds4flash-tp3/.env.tp3-ds}"
patch_src="${DS4FLASH_PATCH:-$HOME/ds4flash-tp3/patches/tilelang.py}"
cache_root="${DS4FLASH_CACHE:-$HOME/.cache/ds4flash-tp3}"
mgmt_if="${MGMT_IF:-enP7s7}"   # DGX Spark management NIC (bootstrap LAN)
# One GPU owner per box: refuse to start beside any resident model lane.
# Tune the pattern to whatever else runs on your boxes.
resident_pattern="${RESIDENT_PATTERN:-vllm|sglang|exl|rank[0-9]}"

[[ -f "$env_file" ]] || { echo "missing $env_file (run launch/ds4flash-tp3-up stage-env)" >&2; exit 1; }
# shellcheck disable=SC1090
source "$env_file"

case "$(hostname -s)" in
  "$HEAD_HOST") rank=0; host_ip="$HEAD_IP"; hca="$HEAD_HCA"; headless=0 ;;
  "$W1_HOST")   rank=1; host_ip="$W1_IP";   hca="$W1_HCA";   headless=1 ;;
  "$W2_HOST")   rank=2; host_ip="$W2_IP";   hca="$W2_HCA";   headless=1 ;;
  *) echo "unsupported host: $(hostname -s) (expected HEAD_HOST/W1_HOST/W2_HOST from the env)" >&2; exit 2 ;;
esac

case "$rank" in
  0) container="ds4flash-tp3-head" ;;
  1) container="ds4flash-tp3-worker1" ;;
  2) container="ds4flash-tp3-worker2" ;;
esac
image="$IMAGE${IMAGE_DIGEST:+@$IMAGE_DIGEST}"

preflight() {
  test -f "$MODEL_DIR/_DOWNLOAD_COMPLETE.json" || {
    echo "checkpoint not fully staged: $MODEL_DIR/_DOWNLOAD_COMPLETE.json missing" >&2; return 1; }
  local shards
  shards=$(find "$MODEL_DIR" -maxdepth 1 -type f \
    -name 'model-[0-9][0-9][0-9][0-9][0-9]-of-00048.safetensors' | wc -l)
  [[ "$shards" -eq "$EXPECTED_SHARDS" ]] || {
    echo "shard count $shards != EXPECTED_SHARDS $EXPECTED_SHARDS" >&2; return 1; }
  test -f "$MODEL_DIR/config.json"
  docker image inspect "$image" >/dev/null 2>&1 || {
    echo "image missing: $image" >&2; return 1; }
  test -e /dev/infiniband || { echo "/dev/infiniband absent" >&2; return 1; }
  ip -br link | grep -Eq 'enp1s0f[01]np[01].*UP' || { echo "CX-7 link down" >&2; return 1; }
  # One GPU owner per box: refuse beside any resident model lane.
  local busy
  busy=$(docker ps --format '{{.Names}}' | grep -Ei "$resident_pattern" | grep -v "$container" || true)
  [[ -z "$busy" ]] || { echo "refusing: resident model container(s) active: $busy" >&2; return 1; }
}

common_serve_args=(
  --model "$MODEL_DIR"
  --served-model-name "$SERVED_NAME" deepseek
  --tensor-parallel-size 3
  --distributed-executor-backend ray
  --trust-remote-code
  --kv-cache-dtype "$KV_CACHE_DTYPE"
  --block-size 256
  --max-model-len "$MAX_MODEL_LEN"
  --max-num-seqs "$MAX_NUM_SEQS"
  --max-num-batched-tokens "$MAX_NUM_BATCHED_TOKENS"
  --gpu-memory-utilization "$GPU_MEM_UTIL"
  --enable-prefix-caching
  --enable-chunked-prefill
  --moe-backend b12x
  --attention-backend B12X_MLA_SPARSE
  --load-format safetensors
  --tokenizer-mode deepseek_v4
  --tool-call-parser deepseek_v4
  --reasoning-parser deepseek_v4
  --enable-auto-tool-choice
)
case "${COMPILE_MODE:-eager}" in
  full)
    common_serve_args+=(
      --compilation-config '{"cudagraph_mode":"FULL_AND_PIECEWISE","custom_ops":["all"]}'
      --max-cudagraph-capture-size "${MAX_CUDAGRAPH_CAPTURE_SIZE:-24}"
    ) ;;
  piecewise)
    common_serve_args+=(
      --compilation-config '{"cudagraph_mode":"PIECEWISE","custom_ops":["all"]}'
      --max-cudagraph-capture-size "${MAX_CUDAGRAPH_CAPTURE_SIZE:-24}"
    ) ;;
  *) common_serve_args+=(--enforce-eager) ;;
esac
if [[ "$headless" == 0 ]]; then
  common_serve_args+=(--host 0.0.0.0 --port "$API_PORT")
else
  common_serve_args+=(--headless)
fi

start() {
  preflight
  mkdir -p "$cache_root"/{vllm,flashinfer,triton,torch,b12x-cute,nccl,ray}
  docker rm -f "$container" 2>/dev/null || true
  local patch_mount=()
  # The tilelang dynamo patch is required for the compiled modes.
  if [[ -f "$patch_src" ]]; then
    patch_mount=(-v "$patch_src":/opt/venv/lib/python3.12/site-packages/vllm/model_executor/kernels/mhc/tilelang.py:ro)
  elif [[ "${COMPILE_MODE:-eager}" != eager ]]; then
    echo "COMPILE_MODE=$COMPILE_MODE needs $patch_src (stage patches/ with the env)" >&2; return 1
  fi
  # Workers start first so the head never waits on a cold container.
  docker run -d --name "$container" \
    --privileged --network host --ipc host \
    --shm-size 64g --ulimit memlock=-1 \
    --gpus all \
    --restart no \
    --entrypoint bash \
    -v "$MODEL_DIR":"$MODEL_DIR":ro \
    -v "$cache_root/vllm":"/root/.cache/vllm" \
    -v "$cache_root/flashinfer":"/root/.cache/flashinfer" \
    -v "$cache_root/triton":"/root/.cache/triton" \
    -v "$cache_root/torch":"/root/.cache/torch" \
    -v "$cache_root/b12x-cute":"/root/.cache/b12x-cute" \
    -v "$cache_root/nccl":"/root/.cache/nccl" \
    -v "$cache_root/ray":"/tmp/ray" \
    "${patch_mount[@]}" \
    -e NCCL_IB_DISABLE="$NCCL_IB_DISABLE" \
    -e NCCL_IB_HCA="$hca" \
    -e NCCL_IB_GID_INDEX="$NCCL_IB_GID_INDEX" \
    -e NCCL_IB_ROCE_VERSION_NUM="$NCCL_IB_ROCE_VERSION_NUM" \
    -e NCCL_CROSS_NIC="$NCCL_CROSS_NIC" \
    -e NCCL_IB_SUBNET_AWARE_ROUTING="$NCCL_IB_SUBNET_AWARE_ROUTING" \
    -e NCCL_P2P_DISABLE="$NCCL_P2P_DISABLE" \
    -e NCCL_SHM_DISABLE="$NCCL_SHM_DISABLE" \
    -e NCCL_BUFFSIZE="$NCCL_BUFFSIZE" \
    -e NCCL_LL128_BUFFSIZE="$NCCL_LL128_BUFFSIZE" \
    -e NCCL_PROTO="$NCCL_PROTO" \
    -e NCCL_MAX_NCHANNELS="$NCCL_MAX_NCHANNELS" \
    -e NCCL_MIN_NCHANNELS="$NCCL_MIN_NCHANNELS" \
    -e NCCL_ALGO="${NCCL_ALGO:-Ring}" \
    -e NCCL_NET_GDR_LEVEL="${NCCL_NET_GDR_LEVEL:-0}" \
    -e NCCL_DEBUG="$NCCL_DEBUG" \
    -e NCCL_SOCKET_IFNAME="$mgmt_if" \
    -e GLOO_SOCKET_IFNAME="$mgmt_if" \
    -e LD_PRELOAD=/opt/nccl230/build/lib/libnccl.so.2 \
    -e NCCL_LOCAL_INFERENCE_PATH= \
    -e NCCL_PR2127_PATH= \
    -e VLLM_NCCL_SO_PATH= \
    -e UCX_MEM_MMAP_HOOK_MODE="$UCX_MEM_MMAP_HOOK_MODE" \
    -e UCX_RCACHE_MAX_UNRELEASED="$UCX_RCACHE_MAX_UNRELEASED" \
    -e PYTORCH_CUDA_ALLOC_CONF="$PYTORCH_CUDA_ALLOC_CONF" \
    -e RAY_memory_monitor_refresh_ms=0 \
    -e VLLM_USE_RAY_V2_EXECUTOR_BACKEND=1 \
    -e VLLM_ENABLE_PCIE_ALLREDUCE=0 \
    -e VLLM_HOST_IP="$host_ip" \
    -e CUTE_DSL_ARCH="$CUTE_DSL_ARCH" \
    -e TORCH_CUDA_ARCH_LIST="$TORCH_CUDA_ARCH_LIST" \
    -e VLLM_USE_B12X_MOE="$VLLM_USE_B12X_MOE" \
    -e VLLM_USE_B12X_SPARSE_INDEXER="$VLLM_USE_B12X_SPARSE_INDEXER" \
    -e VLLM_USE_B12X_FP8_GEMM="$VLLM_USE_B12X_FP8_GEMM" \
    -e VLLM_USE_B12X_WO_PROJECTION=1 \
    -e VLLM_USE_B12X_MHC=1 \
    -e B12X_MOE_FORCE_A8=1 \
    -e B12X_MLA_SM120_UNIFIED="$B12X_MLA_SM120_UNIFIED" \
    -e VLLM_USE_V2_MODEL_RUNNER="$VLLM_USE_V2_MODEL_RUNNER" \
    -e VLLM_ALLOW_LONG_MAX_MODEL_LEN="$VLLM_ALLOW_LONG_MAX_MODEL_LEN" \
    -e SAFETENSORS_FAST_GPU="$SAFETENSORS_FAST_GPU" \
    -e VLLM_USE_BREAKABLE_CUDAGRAPH="$VLLM_USE_BREAKABLE_CUDAGRAPH" \
    "$image" \
    -c "$(
      if [[ "$headless" == 0 ]]; then
        printf 'python3 -m pip install --quiet ray==2.55.1 >/dev/null && python3 -m pip install --quiet --force-reinstall --no-deps git+https://github.com/lukealonso/b12x.git@08e980c303b0b6291700a6b85aa09aa874fc27cb >/dev/null && ray start --head --port=6379 --num-gpus=1 --node-ip-address=%q --object-store-memory=1073741824 --dashboard-host=0.0.0.0 >/dev/null && exec python3 -m vllm.entrypoints.openai.api_server%s' "$HEAD_IP" "$(printf ' %q' "${common_serve_args[@]}")"
      else
        printf 'python3 -m pip install --quiet ray==2.55.1 >/dev/null && python3 -m pip install --quiet --force-reinstall --no-deps git+https://github.com/lukealonso/b12x.git@08e980c303b0b6291700a6b85aa09aa874fc27cb >/dev/null && ray start --address=%q:6379 --num-gpus=1 --node-ip-address=%q --object-store-memory=1073741824 --block' "$HEAD_IP" "$host_ip"
      fi
    )"
  echo "started $container (rank $rank on $(hostname -s)); logs: docker logs -f $container"
}

case "$action" in
  start)   start ;;
  stop)    docker rm -f "$container" 2>/dev/null || true; echo "stopped $container" ;;
  status)
    if docker inspect --format '{{.State.Status}}' "$container" 2>/dev/null; then
      docker logs --tail 5 "$container" 2>&1 | sed 's/^/  /'
    else
      echo "$container not present on $(hostname -s)"
    fi ;;
  logs)    docker logs -f --tail 100 "$container" ;;
  preflight) preflight && echo "preflight ok on $(hostname -s) (rank $rank)" ;;
  *) echo "usage: ds4flash-tp3-spark {start|stop|status|logs|preflight}" >&2; exit 2 ;;
esac
