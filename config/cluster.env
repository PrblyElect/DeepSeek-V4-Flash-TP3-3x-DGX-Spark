# ds4flash-tp3 cluster env — SPEED profile (karmic-kraken lineage + DSpark
# speculative decoding): the exact profile validated 2026-10-03/04 (bring-up
# ladder in docs/FIXLOG.md, acceptance battery + soak in the README).
# Decode ~3x the capacity profile via DSpark k=5 + async scheduling + FULL
# cudagraphs, at the cost of a smaller KV pool (~2.3-2.6M vs the capacity
# profile's ~7.5-7.6M tokens).
#
# Staged to every box as ~/ds4flash-tp3/.env.tp3-ds-karmic by
#   launch/ds4flash-tp3-up stage-env          # (this file is the default)
# Switch profiles with ENV_SRC=config/cluster.env.capacity (see README).
#
# EDIT the blocks marked EDIT for your site; everything else is pinned to
# the validated profile.

STACK='karmic'

# --- checkpoint (EDIT: identical path on all three boxes; any deepseek_v4
# --- checkpoint in the native mixed FP4+FP8 packaging works — validated
# --- with the 48-shard abliterated SuperDeepseek MQ repack; the official
# --- HF repo is 46 shards, adjust EXPECTED_SHARDS + the helper's shard
# --- glob if you stage that one) ---
MODEL_REPO='Jiunsong/SuperDeepseek-V4-Flash-abliterated-MQ-2xDGX'
MODEL_SHA='2a7dd6a12d46f752e290c6255140a42600897864'
MODEL_DIR='/home/YOURUSER/models/superdeepseek-v4-flash-abliterated-mq-2xdgx-2a7dd6a12d46'
EXPECTED_SHARDS=48
SERVED_NAME='ds4flash'   # the helper also aliases the engine as `deepseek`

# --- runtime image: the only prebuilt ARM64 image of the karmic-kraken
# --- lineage found as of 2026-10-04 (the project's own ghcr package is
# --- amd64-only — verified across its full tag list; ARM users otherwise
# --- build from source). nightly-20261004 = vllm
# --- 0.1.dev21553+gab86b7073, b12x 1.5.0 baked in (no start-time wheel
# --- upgrades needed on this stack), system NCCL 2.32.x. Digest-pinned;
# --- a newer nightly requires re-validating the patches-karmic/ mounts
# --- against its tree before use. ---
IMAGE='eugr/spark-vllm-b12x'
IMAGE_DIGEST='sha256:66147fc1420dbd59a7bb1411697d81a8231c298105b61c5962179cd146b4a41b'

# --- roles (EDIT: short hostnames must equal `hostname -s` on each box;
# --- IPs are the management LAN; the head serves the API and hosts the mp
# --- rendezvous) ---
HEAD_HOST='spark-head'   HEAD_IP='192.168.0.10'
W1_HOST='spark-a'        W1_IP='192.168.0.11'
W2_HOST='spark-b'        W2_IP='192.168.0.12'
API_PORT='8889'
MASTER_PORT='9999'       # mp-executor rendezvous port; keep <10000 and
                         # outside the ephemeral range (ring convention)

# --- per-rank RoCE pins (EDIT only if `ibstat` names differ on your box).
# --- Full three-cable triangle, one /24 per leg; every rank pins BOTH
# --- on-board HCAs and NCCL picks the per-peer legs. ---
HEAD_HCA='rocep1s0f0,rocep1s0f1'
W1_HCA='rocep1s0f0,rocep1s0f1'
W2_HCA='rocep1s0f0,rocep1s0f1'

# --- serving profile (validated; workload-split numbers in the README:
# --- count/code-class ~100-108 tok/s, prose ~45-50; ~2.3-2.6M-token KV
# --- pool at capture 144) ---
# gmu ladder (A/B'd live, same-day paired boots): 0.79 adopted. 0.80
# costs the 16-way aggregate ~14% (the cliff sits between 0.79 and 0.80
# on this image); 0.78 is equal-speed with ~150K fewer pool tokens.
# Pool has ±6-8% boot-to-boot noise — single-boot deltas are weak evidence.
GPU_MEM_UTIL='0.79'
MAX_MODEL_LEN='1048576'
MAX_NUM_SEQS='24'
MAX_NUM_BATCHED_TOKENS='8192'   # 16384 crashes 0731 sparse_mla metadata init
KV_CACHE_DTYPE='fp8'
# DSpark speculative decoding, k=5, probabilistic drafting. The TP=3 gate is
# part of patches-karmic/config.py (the DSparkDraftModel routing) — without
# the patches, spec validation dies on the raw 64 % 3 head check.
SPEC_CONFIG='{"method":"dspark","num_speculative_tokens":5,"draft_sample_method":"probabilistic","rejection_sample_method":"standard","attention_backend":"B12X"}'
# This fork's AttentionConfig schema has no use_fp4_indexer_cache field
# (upstream-only); leave empty — the helper then omits the flag entirely.
ATTENTION_CONFIG=''
# Stock safetensors-shard checkpoints: the default "instanttensor" loader
# rejects them ("pytorch format only") — use the native safetensors loader.
LOAD_FORMAT='safetensors'

# --- engine env (karmic conventions) ---
CUTE_DSL_ARCH='sm_121a'
VLLM_USE_AOT_COMPILE=1
VLLM_USE_MEGA_AOT_ARTIFACT=1
VLLM_MEMORY_PROFILE_INCLUDE_ATTN=1
VLLM_USE_FLASHINFER_SAMPLER=1
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_USE_B12X_WO_PROJECTION=1
VLLM_USE_B12X_MHC=1
VLLM_USE_B12X_FP8_GEMM=1
VLLM_USE_B12X_MOE=1
VLLM_USE_B12X_SPARSE_INDEXER=1
B12X_MLA_SM120_UNIFIED=1
B12X_MOE_FORCE_A8=1
B12X_W4A8_TINY_DECODE=0        # CORRECTNESS-CRITICAL: 1 omits the SwiGLU
                               # clamp on this model class — do not enable
VLLM_MOE_SKIP_PADDING=0
VLLM_PLUGINS='b12x_loader'
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_ENGINE_READY_TIMEOUT_S=3600
VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=900
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=1
SAFETENSORS_FAST_GPU=1
OMP_NUM_THREADS=8
TORCH_NCCL_ASYNC_ERROR_HANDLING=1
CUDA_DEVICE_MAX_CONNECTIONS=32
PYTORCH_CUDA_ALLOC_CONF='expandable_segments:True,garbage_collection_threshold:0.6'

# --- NCCL: karmic multi-node ring conventions (as validated; the capacity
# --- profile deliberately differs — see its comments before mixing) ---
NCCL_IB_DISABLE=0
NCCL_NET='IB'
NCCL_NET_PLUGIN='none'
NCCL_IB_GID_INDEX=3
NCCL_IB_ADDR_FAMILY='AF_INET'
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_IB_SUBNET_AWARE_ROUTING=1
# A/B'd live on this stack: 0 beats 1 by ~3-4% prefill (decode/aggregate
# unchanged within noise). Both profiles in this repo now run P2P enabled.
NCCL_P2P_DISABLE=0
NCCL_NVLS_ENABLE=0
NCCL_PROTO='^LL128'
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144
NCCL_MAX_NCHANNELS=8
NCCL_MIN_NCHANNELS=8
NCCL_DEBUG='WARN'

# --- client note (not engine config): this build's deepseek_v4 reasoning
# --- parser defaults thinking ON. Send chat_template_kwargs
# --- {"thinking": false} or budget for reasoning_content in max_tokens.
# --- See README "Thinking mode & sampling".
