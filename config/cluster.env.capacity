# ds4flash-tp3 cluster env — CAPACITY profile (chthonic lineage, no spec
# decode): the profile validated 2026-10-03/04 (9/9 clean cold boots at
# MAX_NUM_BATCHED_TOKENS=8192) and since re-tuned to 4096 after a
# measured four-effect win — pool, prefill, decode fairness, decode
# (see README landmine 14 + FIXLOG tuning notes). Adapted from the
# chthonic MiniMax-M3 TP=3
# recipe's env for DeepSeek-V4-Flash. ~7.5-7.6M-token KV pool — the
# max-context end of the two profiles in this repo.
#
# Staged to every box as ~/ds4flash-tp3/.env.tp3-ds by
#   ENV_SRC=config/cluster.env.capacity launch/ds4flash-tp3-up stage-env
# (the default ENV_SRC is the SPEED profile, config/cluster.env).
#
# EDIT the blocks marked EDIT for your site; everything else is pinned to
# the validated profile.

STACK='chthonic'

# --- checkpoint (EDIT: identical path on all three boxes; any deepseek_v4
# --- checkpoint in the native mixed FP4+FP8 packaging works — validated
# --- with the 48-shard abliterated SuperDeepseek MQ repack; the official
# --- HF repo is 46 shards, adjust EXPECTED_SHARDS + the helper's shard
# --- glob if you stage that one) ---
MODEL_REPO='Jiunsong/SuperDeepseek-V4-Flash-abliterated-MQ-2xDGX'
MODEL_SHA='2a7dd6a12d46f752e290c6255140a42600897864'
MODEL_DIR='/home/YOURUSER/models/superdeepseek-v4-flash-abliterated-mq-2xdgx-2a7dd6a12d46'
EXPECTED_SHARDS=48
SERVED_NAME='ds4flash'   # the helper also aliases the engine as `deepseek`

# --- runtime image (chthonic-consecration lineage: generic DeepSeek V4
# --- virtual-TP plan, b12x DS4 kernels, NCCL 2.30u1 built for sm_121).
# --- Digest pinned 2026-10-03. The image bakes the M3 recipe's NCCL poison
# --- (a 2.30.4 LD_PRELOAD shim + NCCL_IB_DISABLE=1); the node helper
# --- overrides it — the boot log must read "NCCL version 2.30.7". ---
IMAGE='ghcr.io/tonyd2wild/vllm-m3-chthonic:nccl230u1'
IMAGE_DIGEST='sha256:cdeae56d23d0d3f35a21c67c9f3e47979725a1ef9cd65faa6134b91871497be2'

# --- roles (EDIT: short hostnames must equal `hostname -s` on each box;
# --- IPs are the management LAN; the head serves the API) ---
HEAD_HOST='spark-head'   HEAD_IP='192.168.0.10'
W1_HOST='spark-a'        W1_IP='192.168.0.11'
W2_HOST='spark-b'        W2_IP='192.168.0.12'
API_PORT='8889'

# --- per-rank RoCE pins (EDIT only if `ibstat` names differ on your box).
# --- Full three-cable triangle, one /24 per leg; every rank pins BOTH
# --- on-board HCAs and NCCL picks the per-peer legs. ---
HEAD_HCA='rocep1s0f0,rocep1s0f1'
W1_HCA='rocep1s0f0,rocep1s0f1'
W2_HCA='rocep1s0f0,rocep1s0f1'
NCCL_IB_GID_INDEX=3
# If the mesh throws ibv_modify_qp err-110, unset NCCL_IB_GID_INDEX:
# hardcoding it can defeat CIDR-driven per-peer GID selection on switchless
# meshes (the MiniMax recipe's finding).

# --- serving profile (validated production profile; see README) ---
# gmu ladder (A/B'd live at 8192): 0.80 adopted on capacity — ~+10% pool over
# 0.78 (≈5.4M vs ≈4.9M tokens, 8192-era absolutes; the 4096 retune
# supersedes the pool level) with speed at/above the 0.78 bands.
# Head-box floor measured ~3.2 GiB through a 500K-token cold prefill;
# keep OCR-class co-tenants on the worker boxes (11-12 GiB free there).
GPU_MEM_UTIL='0.80'
MAX_MODEL_LEN='1048576'
MAX_NUM_SEQS='24'
# 4096 (no-spec rule, landmine 14): +40-54% KV pool (workspace->KV),
# ~1.7x prefill, ~2.6x fairer decode under big prefills. Spec profiles
# keep 8192 — 4096 starves the DSpark draft/verify pipeline.
MAX_NUM_BATCHED_TOKENS='4096'   # 16384 is a measured trap: ~1.9M tokens of KV pool for zero prefill gain
KV_CACHE_DTYPE='fp8'

# --- engine env ---
CUTE_DSL_ARCH='sm_121a'
TORCH_CUDA_ARCH_LIST='12.1a'
VLLM_USE_B12X_MOE=1
VLLM_USE_B12X_SPARSE_INDEXER=1
VLLM_USE_B12X_FP8_GEMM=1
B12X_MLA_SM120_UNIFIED=1
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
SAFETENSORS_FAST_GPU=1
VLLM_USE_BREAKABLE_CUDAGRAPH=0
# Async scheduling deliberately OFF: on the chthonic lineage it desyncs TP
# collectives and crashes multi-node (community TP=2 reports on this fork).
# Capture list trimmed to the running seq count; unused graph sizes cost
# ~2 GiB/node.
MAX_CUDAGRAPH_CAPTURE_SIZE='24'
# COMPILE_MODE: full = FULL_AND_PIECEWISE cudagraphs (production: ~29-30
# tok/s single-stream at 4096; requires patches/tilelang.py, staged with the env);
# piecewise = PIECEWISE only (~11 tok/s); eager = no compile (~6.4 tok/s,
# correctness-first fallback).
COMPILE_MODE='full'
# Bring-up mechanics (from the DS4-family TP3/TP4 lanes): fresh docker run
# only — never docker restart; `sync; echo 3 > /proc/sys/vm/drop_caches` on
# every rank right before boot or the driver OOMs during load; reboots
# revert CX-7 MTU to 1500 (re-apply 9000); a NIC stuck at ~13 Gb/s or a GPU
# latched <1 GHz is fixed by a cold power-drain (~90 s unplugged), NOT a
# warm reboot.
# NO --enable-expert-parallel: the chthonic virtual-TP padded path
# (heads 64->72, o_groups 8->9, moe 2048->2112) engages automatically at
# TP=3 and refuses EP. Verify any checkpoint's plan first with
# tools/validate-tp3-plan.py (runs offline against any checkout of the
# fork, or inside the pinned image).

# --- NCCL (validated on the three-cable triangle) ---
NCCL_IB_DISABLE=0
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_CROSS_NIC=1
NCCL_IB_SUBNET_AWARE_ROUTING=1
# Leave P2P/SHM ENABLED (0): the older Spark recipes' disable pins halve
# prefill throughput on this stack (measured ~50 s -> ~25 s on a ~21K prompt).
NCCL_P2P_DISABLE=0
NCCL_SHM_DISABLE=0
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144
NCCL_PROTO='^LL128'
NCCL_MAX_NCHANNELS=4
NCCL_MIN_NCHANNELS=4
# Fewer channels beats 8 on GB10 RoCE (community finding); Ring pinned;
# GDR level 0 per the M3-TP3 lineage. A/B'd on our triangle: prefill/decode
# unchanged within noise — kept as the community-best stable pins.
NCCL_ALGO='Ring'
NCCL_NET_GDR_LEVEL=0
NCCL_DEBUG='WARN'

# --- host-side stability pins ---
UCX_MEM_MMAP_HOOK_MODE='none'
UCX_RCACHE_MAX_UNRELEASED='1024'
PYTORCH_CUDA_ALLOC_CONF='expandable_segments:True'
